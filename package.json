{
  "name": "olaink",
  "private": true,
  "version": "0.0.1",
  "description": "End-to-end encrypted exchange of complete Supernote note files",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "pretest": "node scripts/embed-onboard-page.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "check:generated": "node scripts/embed-onboard-page.mjs --check",
    "build": "npm run build --workspaces --if-present",
    "build:plugin": "bash packages/plugin/buildPlugin.sh",
    "verify:plugin": "packages/plugin/verifySnplg.sh packages/plugin/build/outputs/olainkplugin.snplg",
    "reload:plugin": "scripts/snplg-hotreload.sh --build",
    "server": "npm run start -w @olaink/server",
    "build:server": "npm run build -w @olaink/server",
    "build:server:arm64": "npm run build:arm64 -w @olaink/server",
    "build:android": "cd android && JAVA_HOME=\"${JAVA_HOME:-$HOME/jdk17}\" ANDROID_HOME=\"${ANDROID_HOME:-$HOME/android-sdk}\" ./gradlew assembleDebug",
    "deploy:android": "npm run build:android && adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "deploy:plugin": "scripts/snplg-deploy.sh packages/plugin",
    "logs": "scripts/snplg-logs.sh",
    "logs:capture": "scripts/snplg-logs.sh --capture --quiet",
    "native:e2:relay:start": "bash scripts/native-e2-relay.sh start",
    "native:e2:relay:stop": "bash scripts/native-e2-relay.sh stop",
    "native:e2:relay:reset": "bash scripts/native-e2-relay.sh reset",
    "native:e2:relay:status": "bash scripts/native-e2-relay.sh status",
    "native:e2:relay:pin": "bash scripts/native-e2-relay.sh pin",
    "native:e2:relay:tailscale-cert": "bash scripts/native-e2-relay.sh tailscale-cert",
    "native:e2:build": "bash scripts/native-e2-build.sh",
    "native:e2:deploy": "npm run native:e2:build && scripts/snplg-deploy.sh experiments/native-client-plugin --no-build",
    "native:e2:test": "cd experiments/native-client-plugin/android && JAVA_HOME=\"${JAVA_HOME:-$HOME/jdk17}\" ANDROID_HOME=\"${ANDROID_HOME:-$HOME/android-sdk}\" ./gradlew :app:testDebugUnitTest",
    "native:e2:peer:reset": "rm -f experiments/native-client-plugin/e2/peer-state.json",
    "native:e2:peer:setup": "NODE_TLS_REJECT_UNAUTHORIZED=0 node experiments/native-client-plugin/e2/peer.mjs setup https://127.0.0.1:8443",
    "native:e2:peer:pairing": "NODE_TLS_REJECT_UNAUTHORIZED=0 node experiments/native-client-plugin/e2/peer.mjs pairing",
    "native:e2:peer:status": "NODE_TLS_REJECT_UNAUTHORIZED=0 node experiments/native-client-plugin/e2/peer.mjs status",
    "native:e2:peer:receive": "NODE_TLS_REJECT_UNAUTHORIZED=0 node experiments/native-client-plugin/e2/peer.mjs receive",
    "native:e2:peer:send-back": "NODE_TLS_REJECT_UNAUTHORIZED=0 node experiments/native-client-plugin/e2/peer.mjs send-back",
    "native:e2:peer:send-tampered": "NODE_TLS_REJECT_UNAUTHORIZED=0 node experiments/native-client-plugin/e2/peer.mjs send-tampered"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "preact": "^10.27.2"
  }
}

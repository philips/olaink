---
import '../../../ui/src/olaink.css';
import { olaInkHeader, olaInkNavLink } from '../../../ui/src/templates.mjs';

const latestReleaseUrl = "https://github.com/philips/olaink/releases/latest";
const githubUrl = "https://github.com/philips/olaink";
const privacyUrl = "/privacy/";
const header = olaInkHeader({
  homeHref: '/',
  logoSrc: '/olaink-logo.svg',
  navigation: [
    olaInkNavLink({ href: privacyUrl, label: 'Privacy' }),
    olaInkNavLink({ href: githubUrl, label: 'GitHub' }),
  ].join(''),
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Install Ola Ink on a Supernote." />
    <meta name="theme-color" content="#F6F4EF" />
    <link rel="icon" href="/olaink-logo.svg" type="image/svg+xml" />
    <title>Install Ola Ink on Supernote</title>
  </head>
  <body>
    <main>
      <Fragment set:html={header} />

      <header>
        <p class="eyebrow">SUPERNOTE INSTALLATION</p>
        <h1>Bring Ola Ink to your Supernote.</h1>
        <p class="intro">
          Ola Ink is one Supernote plugin file. Download it, place it in MyStyle, and install it with Supernote Plugin Manager.
        </p>
        <a class="button" href={latestReleaseUrl} rel="noopener">Download the latest release <span aria-hidden="true">↗</span></a>
        <p class="release-note">The download opens Ola Ink’s latest GitHub release. Choose the <code>olainkplugin.snplg</code> asset.</p>
      </header>

      <section aria-labelledby="steps-heading">
        <p class="eyebrow">STEP BY STEP</p>
        <h2 id="steps-heading">Install the Ola Ink plugin.</h2>
        <ol class="steps">
          <li>
            <strong>Download the plugin.</strong>
            <p>Open the latest release above on your Supernote, or download it on another device. Download <code>olainkplugin.snplg</code> — not an APK.</p>
          </li>
          <li>
            <strong>Copy it to MyStyle.</strong>
            <p>Move <code>olainkplugin.snplg</code> to <code>/storage/emulated/0/MyStyle/</code> on your Supernote.</p>
          </li>
          <li>
            <strong>Install it in Plugin Manager.</strong>
            <p>Open Supernote Plugin Manager. Choose Add Plugin (or Choose Installation Package), select <code>olainkplugin.snplg</code>, then tap Install.</p>
          </li>
          <li>
            <strong>Open Ola Ink from a note.</strong>
            <p>Open any note in the NOTE app, then choose <b>Ola Ink</b> from the NOTE sidebar. From there you can send the currently open note, open received notes, or pair this device.</p>
          </li>
          <li>
            <strong>Pair this Supernote.</strong>
            <p>In Ola Ink’s Settings tab, visit <b>app.olaink.com</b>, sign in, choose Pair a device, and enter the eight-digit device pairing code.</p>
          </li>
          <li>
            <strong>Send yourself a note.</strong>
            <p>With a note open, choose the Send tab, enter your Ola Ink address, and send. Open the Inbox tab to sync and open received notes.</p>
          </li>

        </ol>
      </section>

      <aside>
        <h2>Plugin permissions</h2>
        <p>
          Ola Ink asks for network access when you pair or sync, and read/write access when you send or open a <code>.note</code> file. These permissions are requested by Supernote when needed.
        </p>
      </aside>

      <p class="help">Only install <code>.snplg</code> files obtained from the Ola Ink GitHub release page.</p>
    </main>

    <footer>
      <span>© {new Date().getFullYear()} <a href="https://infinitelogic.org/" rel="noopener">Infinite Logic PBC</a></span>
      <a href="/">Home</a>
    </footer>
  </body>
</html>

<style>
  :global(:root) { --paper: var(--olaink-paper); --ink: var(--olaink-ink); --sage: var(--olaink-sage); --line: var(--olaink-line); }
  main, footer { max-width: 840px; margin: 0 auto; padding-inline: 28px; }
  :global(.olaink-nav-link), footer a { color: var(--ink); text-underline-offset: 5px; }
  header { padding: 72px 0 86px; border-bottom: 1px solid var(--line); }
  .eyebrow { margin: 0 0 18px; color: var(--sage); font-size: .7rem; font-weight: 700; letter-spacing: .22em; }
  h1, h2 { font-family: Georgia, "Times New Roman", serif; font-weight: 500; letter-spacing: -.035em; }
  h1 { max-width: 660px; margin: 0; font-size: clamp(3.2rem, 8vw, 5.5rem); line-height: .98; }
  .intro { max-width: 600px; margin: 28px 0 32px; color: #435348; font-size: 1.12rem; line-height: 1.65; }
  .button { display: inline-flex; align-items: center; justify-content: center; gap: 18px; padding: 15px 20px; border: 1px solid var(--ink); border-radius: 3px; background: var(--ink); color: var(--paper); font-size: .94rem; font-weight: 650; text-decoration: none; }
  .button:hover, .button:focus-visible { background: transparent; color: var(--ink); }
  .release-note { margin: 14px 0 0; color: #647067; font-size: .85rem; line-height: 1.45; }
  section { padding: 82px 0 50px; }
  section h2 { margin: 0 0 34px; font-size: clamp(2.15rem, 5vw, 3.3rem); line-height: 1.05; }
  .steps { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; counter-reset: steps; }
  .steps li { position: relative; padding: 24px 0 24px 68px; border-top: 1px solid var(--line); counter-increment: steps; }
  .steps li::before { content: "0" counter(steps); position: absolute; left: 0; top: 25px; color: var(--sage); font-size: .78rem; font-weight: 700; letter-spacing: .12em; }
  .steps strong { font-family: Georgia, "Times New Roman", serif; font-size: 1.35rem; font-weight: 500; }
  .steps p { margin: 8px 0 0; color: #526158; line-height: 1.6; }
  code { padding: .12em .3em; border-radius: 3px; background: #ece9e1; font-size: .9em; }
  aside { margin: 18px 0 36px; padding: 28px 30px; border: 1px solid var(--line); background: #eeece5; }
  aside h2 { margin: 0; font-size: 1.5rem; }
  aside p, .help { color: #526158; line-height: 1.6; }
  .help { max-width: 640px; margin: 0 0 86px; font-size: .9rem; }
  footer { display: flex; justify-content: space-between; padding-bottom: 32px; color: var(--sage); font-size: .82rem; }
  @media (max-width: 600px) { main, footer { padding-inline: 22px; } header { padding: 54px 0 62px; } section { padding-top: 60px; } .steps li { padding-left: 54px; } aside { margin-inline: -4px; padding: 24px; } }
</style>

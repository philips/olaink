{
  "name": "@olaink/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ola Ink encrypted whole-note relay prototype with an E2E echo device",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "test:sqlite": "cd ../.. && bunx --bun vitest run packages/server/src/prototypeSqliteStore.test.ts",
    "build": "node ../../scripts/embed-onboard-page.mjs && mkdir -p ../../dist && bun build src/main.ts --compile --outfile ../../dist/olaink-server",
    "build:arm64": "node ../../scripts/embed-onboard-page.mjs && mkdir -p ../../dist && bun build src/main.ts --compile --target=bun-linux-arm64 --outfile ../../dist/olaink-server-linux-arm64"
  }
}
